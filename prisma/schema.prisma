datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum TopicLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum ResourceType {
  ARTICLE
  VIDEO
  DOCS
  COURSE
  PRACTICE
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model User {
  id             String         @id @default(uuid())
  email          String         @unique
  passwordHash   String
  name           String
  avatarUrl      String?
  role           Role           @default(USER)
  currentTrackId String?
  streakDays     Int            @default(0)
  lastActiveDate DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  currentTrack   Track?         @relation(fields: [currentTrackId], references: [id], onDelete: SetNull)
  progress       UserProgress[]
  refreshTokens  RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Track {
  id          String    @id @default(uuid())
  name        String    @unique // e.g. "frontend" | "backend"
  title       String    // e.g. "Frontend Engineering"
  description String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  roadmaps    Roadmap[]
  users       User[]

  @@map("tracks")
}

model Roadmap {
  id          String      @id @default(uuid())
  trackId     String
  title       String
  description String
  version     String      @default("1.0.0")
  isCurrent   Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  track       Track       @relation(fields: [trackId], references: [id], onDelete: Cascade)
  milestones  Milestone[]
  topics      Topic[]

  @@unique([trackId, version])
  @@map("roadmaps")
}

model Milestone {
  id          String   @id @default(uuid())
  roadmapId   String
  title       String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roadmap     Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  topics      Topic[]

  @@map("milestones")
}

model Topic {
  id              String              @id @default(uuid())
  roadmapId       String
  milestoneId     String?
  title           String
  description     String
  level           TopicLevel          @default(BEGINNER)
  order           Int                 @default(0)
  estimatedHours  Float               @default(1.0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  roadmap         Roadmap             @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  milestone       Milestone?          @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  resources       Resource[]
  progress        UserProgress[]

  // DAG: Prerequisites required before this topic can be completed
  prerequisites   TopicPrerequisite[] @relation("DependentTopic")
  // DAG: Topics that require this topic as a prerequisite
  prerequisiteFor TopicPrerequisite[] @relation("PrerequisiteTopic")

  @@map("topics")
}

model TopicPrerequisite {
  topicId        String // The topic that depends on a prerequisite
  prerequisiteId String // The topic that must be completed first

  topic          Topic  @relation("DependentTopic", fields: [topicId], references: [id], onDelete: Cascade)
  prerequisite   Topic  @relation("PrerequisiteTopic", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@id([topicId, prerequisiteId])
  @@map("topic_prerequisites")
}

model Resource {
  id        String       @id @default(uuid())
  topicId   String
  type      ResourceType @default(DOCS)
  url       String
  title     String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  topic     Topic        @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@map("resources")
}

model UserProgress {
  id          String         @id @default(uuid())
  userId      String
  topicId     String
  status      ProgressStatus @default(NOT_STARTED)
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic       Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@map("user_progress")
}
